{
  "name": "pokesmith",
  "version": "0.1.0",
  "scripts": {
    "ng": "node scripts/pokesmith-cli.mjs",
    "start": "node scripts/pokesmith-cli.mjs serve",
    "build": "node scripts/pokesmith-cli.mjs build",
    "preview": "node scripts/pokesmith-cli.mjs preview",
    "start:prod": "node scripts/serve.mjs",
    "watch": "node scripts/pokesmith-cli.mjs build --watch --configuration development",
    "test": "node scripts/pokesmith-cli.mjs team-tests",
    "test:team": "node scripts/pokesmith-cli.mjs team-tests",
    "test:domain": "node scripts/pokesmith-cli.mjs run vgc-multicalc:test-domain --watch=false",
    "lint": "node scripts/pokesmith-cli.mjs lint",
    "formatter": "prettier . --check"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.2.4",
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/material": "22.2.6",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-server": "22.2.4",
    "@angular/router": "22.2.4",
    "@angular/service-worker": "22.2.4",
    "@angular/ssr": "22.2.5",
    "@ngrx/signals": "22.0.1",
    "pdf-lib": "1.17.1",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-istanbul": "5.1.0",
    "angular-eslint": "22.6.0",
    "cypress": "16.2.1",
    "cypress-multi-reporters": "2.1.0",
    "cypress-parallel": "0.15.0",
    "cypress-real-events": "1.15.1",
    "eslint": "10.14.0",
    "istanbul-lib-instrument": "6.0.3",
    "jsdom": "30.1.3",
    "mocha-junit-reporter": "2.2.1",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@ngrx/signals": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    }
